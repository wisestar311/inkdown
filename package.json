{
  "name": "inkdown",
  "private": true,
  "version": "0.3.8",
  "type": "module",
  "description": "실시간 미리보기 마크다운 에디터 (웹 · Windows · macOS, GitHub 동기화)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.electron.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "electron:compile": "tsc -p tsconfig.electron.json",
    "electron:dev": "npm run electron:compile && node scripts/electron-dev.mjs",
    "electron:start": "npm run build && npm run electron:compile && electron .",
    "dist": "npm run build && npm run electron:compile && electron-builder --publish never",
    "dist:win": "npm run build && npm run electron:compile && electron-builder --win --publish never",
    "dist:mac": "npm run build && npm run electron:compile && electron-builder --mac --publish never"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@fontsource/gowun-batang": "^5.3.0",
    "@fontsource/gowun-dodum": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/nanum-myeongjo": "^5.3.0",
    "@fontsource/nanum-pen-script": "^5.3.0",
    "@milkdown/crepe": "^7.23.0",
    "@milkdown/kit": "^7.23.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "codemirror": "^6.0.2",
    "docx": "^9.15.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "katex": "^0.19.1",
    "marked": "^18.1.3",
    "mermaid": "^11.17.2",
    "perfect-freehand": "^1.2.3",
    "pretendard": "^1.3.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "author": "Inkdown",
  "main": "dist-electron/main.cjs",
  "build": {
    "appId": "app.inkdown.editor",
    "productName": "Inkdown",
    "copyright": "Inkdown",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown"
        ],
        "name": "Markdown 문서",
        "role": "Editor"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "identity": null,
      "artifactName": "Inkdown-${version}-mac.${ext}"
    },
    "afterPack": "scripts/adhoc-sign.cjs",
    "dmg": {
      "title": "Inkdown ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Inkdown",
      "artifactName": "Inkdown-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wisestar311/inkdown.git"
  }
}
